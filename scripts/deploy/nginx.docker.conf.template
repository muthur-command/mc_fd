# Nginx for mc_fd container image (Alpine): static + small-concurrency tuning + gzip/cache.
# Rendered at container start from MC_BACKEND_HOST / MC_BACKEND_PORT (see 40-render-nginx-conf.sh).
# TLS is expected at ingress; this listens on port 80 only.

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    client_max_body_size 5M;
    client_body_buffer_size 128k;

    gzip on;
    gzip_comp_level 5;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml
        font/woff2
        font/woff;

    keepalive_timeout 65;

    access_log /var/log/nginx/access.log;

    # Docker embedded DNS; variable proxy_pass defers lookup until request time so
    # nginx can start before mc_bd is registered on the mcos network.
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 80;
        listen [::]:80;
        server_name _;

        root /var/www/mc_fd;

        # Vite hashed assets
        location ^~ /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        location = /index.html {
            add_header Cache-Control "no-cache" always;
            try_files $uri =404;
        }

        location /api/v1/ {
            set $mc_backend "${MC_BACKEND_HOST}:${MC_BACKEND_PORT}";
            proxy_pass http://$mc_backend;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        location /ws/socket.io/ {
            set $mc_backend "${MC_BACKEND_HOST}:${MC_BACKEND_PORT}";
            proxy_pass http://$mc_backend/ws/socket.io/;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_buffering off;
        }

        location /flower/ {
            set $flower_upstream "mc_celery_flower:8555";
            proxy_pass http://$flower_upstream;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_redirect off;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        location ^~ /static/ {
            set $mc_backend "${MC_BACKEND_HOST}:${MC_BACKEND_PORT}";
            proxy_pass http://$mc_backend/static/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
